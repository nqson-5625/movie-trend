# ==============================================================================
# Biến môi trường cho Module 03: HDFS Storage Layer (Kubernetes Native)
# Copy file này thành .env tại modules/hdfs/.env hoặc movie-trend/.env (gốc dự án)
# Cấu hình tối ưu cho cụm Kubernetes k3s trên máy ảo Ubuntu 8GB RAM.
# ==============================================================================

# ------------------------------------------------------------------------------
# CẤU HÌNH KUBERNETES (K3S)
# ------------------------------------------------------------------------------
K8S_NAMESPACE=bigdata
K8S_NAMENODE_POD=hdfs-namenode-0
K8S_NAMENODE_SERVICE=hdfs-namenode-svc
K8S_DATANODE_POD_PREFIX=hdfs-datanode

# Port kết nối HDFS
HDFS_RPC_PORT=9000
HDFS_HTTP_PORT=9870

# URL WebHDFS nội bộ cụm (sử dụng khi Pod chạy trong cluster K8s)
CLUSTER_WEBHDFS_URL=http://hdfs-namenode-svc.bigdata.svc.cluster.local:9870
CLUSTER_DEFAULT_FS=hdfs://hdfs-namenode-svc.bigdata.svc.cluster.local:9000

# URL WebHDFS từ máy Host (khi dùng kubectl port-forward)
HOST_WEBHDFS_URL=http://localhost:9870

# User HDFS (mặc định 'root')
HDFS_USER=root

# ------------------------------------------------------------------------------
# CẤU HÌNH KAFKA SINK INGESTION (Module 02 -> 03)
# ------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLUSTER_BOOTSTRAP_SERVERS=kafka-svc.bigdata.svc.cluster.local:9092
KAFKA_GROUP_ID=hdfs-sink-group
SINK_BATCH_SIZE=500
SINK_FLUSH_INTERVAL=30
