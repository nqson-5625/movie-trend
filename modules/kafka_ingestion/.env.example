# Merge into repository-root .env. Never commit credentials.
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
TMDB_API_KEY=
# Optional Module 01 adapter endpoint override:
# TMDB_BASE_URL=https://api.tmdb.org/3
# Local lifecycle only (not used to connect remote brokers):
KAFKA_HOME=/opt/kafka
KAFKA_HEAP_OPTS=-Xms512m -Xmx512m
# KAFKA_CONFIG=/home/YOUR_USER/kafka-local/config/server.properties
# KAFKA_LOG_DIR=/home/YOUR_USER/kafka-local/logs
