{
  "index_patterns": [
    "analytics_genre_trends",
    "analytics_genre_trends_*",
    "dev_p2_analytics_genre_trends*",
    "dev_p3_analytics_genre_trends*",
    "dev_p4_analytics_genre_trends*",
    "dev_p5_analytics_genre_trends*"
  ],
  "priority": 200,
  "composed_of": [
    "movie_trend_base_settings",
    "movie_trend_batch_meta",
    "movie_trend_analytics_meta"
  ],
  "template": {
    "mappings": {
      "properties": {
        "ref_version": { "type": "keyword" },
        "manifest_hash": { "type": "keyword" },
        "period_type": { "type": "keyword" },
        "period_start": { "type": "date", "format": "strict_date" },
        "genre": {
          "type": "keyword",
          "fields": {
            "text": { "type": "text" }
          }
        },
        "interaction_count": { "type": "long" },
        "rating_count": { "type": "long" },
        "rating_sum": { "type": "double" },
        "avg_rating": { "type": "double" },
        "rank_in_period": { "type": "integer" }
      }
    }
  }
}
