# Copy these settings to .env at the project root (movie-trend/.env).
# Use the TMDB API Key (v3), not the API Read Access Token.
TMDB_API_KEY=your_tmdb_v3_api_key
MOVIELENS_VARIANT=ml-latest-small

# Optional: select a TMDB host directly. Without this setting, the adapter
# tries api.themoviedb.org, then api.tmdb.org on connection errors.
# TMDB_BASE_URL=https://api.tmdb.org/3
