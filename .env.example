# ==============================================================================
# BIẾN MÔI TRƯỜNG DÙNG CHUNG TOÀN HỆ THỐNG — DỰ ÁN MOVIE-TREND
# Copy file này thành .env tại thư mục gốc repository (BTL/.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MODULE 01: DATA SOURCE & PREPARATION
# ------------------------------------------------------------------------------
TMDB_API_KEY=your_tmdb_v3_api_key
MOVIELENS_VARIANT=ml-latest-small
# TMDB_BASE_URL=https://api.tmdb.org/3

# ------------------------------------------------------------------------------
# 2. MODULE 02: KAFKA INGESTION
# ------------------------------------------------------------------------------
# Local dev (WSL / Host):
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
# Nội bộ Kubernetes Cluster:
KAFKA_CLUSTER_BOOTSTRAP_SERVERS=kafka-svc.bigdata.svc.cluster.local:9092
KAFKA_HOME=/opt/kafka
KAFKA_HEAP_OPTS=-Xms512m -Xmx512m

# ------------------------------------------------------------------------------
# 3. MODULE 03: HDFS STORAGE LAYER (Kubernetes Native — k3s)
# ------------------------------------------------------------------------------
K8S_NAMESPACE=bigdata
K8S_NAMENODE_POD=hdfs-namenode-0
K8S_NAMENODE_SERVICE=hdfs-namenode-svc
K8S_DATANODE_POD_PREFIX=hdfs-datanode

# Port kết nối HDFS
HDFS_RPC_PORT=9000
HDFS_HTTP_PORT=9870

# HDFS DefaultFS & WebHDFS Endpoints
# (Nội bộ cụm Kubernetes - Dành cho MapReduce, Spark, Sink Pods)
CLUSTER_DEFAULT_FS=hdfs://hdfs-namenode-svc.bigdata.svc.cluster.local:9000
CLUSTER_WEBHDFS_URL=http://hdfs-namenode-svc.bigdata.svc.cluster.local:9870

# (Truy cập từ Host ngoài cụm qua 'make -C modules/hdfs forward')
HOST_DEFAULT_FS=hdfs://localhost:9000
HOST_WEBHDFS_URL=http://localhost:9870

HDFS_USER=root

# Cấu hình Ingestion Sink Daemon (Kafka -> HDFS)
KAFKA_GROUP_ID=hdfs-sink-group
SINK_BATCH_SIZE=200
SINK_FLUSH_INTERVAL=30
