{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "analytics_growth document (Phase2-3.0 analytics lịch sử, P4; D4 history)",
  "description": "Grain (window_size, window_start, entity_type, entity_key); _id = serialize_key_v1 của tuple đó. previous = đúng window_start - window_size cùng entity/size; thiếu previous -> present=false, previous_window_count=null, trending_score=null.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analytics_run_id",
    "published_at",
    "window_start",
    "window_end",
    "window_size",
    "entity_type",
    "entity_key",
    "movieId",
    "genre",
    "title",
    "title_source",
    "current_window_count",
    "previous_window_count",
    "previous_window_present",
    "trending_score",
    "rating_count",
    "rating_sum",
    "avg_rating",
    "updated_at",
    "timeline_mode"
  ],
  "properties": {
    "schema_version": {
      "const": "phase2-3.0"
    },
    "analytics_run_id": {
      "type": "string",
      "minLength": 1
    },
    "published_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "window_start": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "window_end": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "window_size": {
      "enum": [
        "10m",
        "1h"
      ]
    },
    "entity_type": {
      "enum": [
        "movie",
        "genre"
      ]
    },
    "entity_key": {
      "type": "string",
      "minLength": 1
    },
    "movieId": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "genre": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "title_source": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "current_window_count": {
      "type": "integer",
      "minimum": 1
    },
    "previous_window_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "previous_window_present": {
      "type": "boolean"
    },
    "trending_score": {
      "type": [
        "number",
        "null"
      ]
    },
    "rating_count": {
      "type": "integer",
      "minimum": 1
    },
    "rating_sum": {
      "type": "number",
      "minimum": 0.5
    },
    "avg_rating": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 5.0
    },
    "updated_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "timeline_mode": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "entity_type": {
            "const": "movie"
          }
        }
      },
      "then": {
        "properties": {
          "movieId": {
            "type": "integer"
          },
          "genre": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "movieId": {
            "type": "null"
          },
          "genre": {
            "type": "string"
          },
          "title": {
            "type": "null"
          },
          "title_source": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "previous_window_present": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "previous_window_count": {
            "type": "null"
          },
          "trending_score": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "previous_window_count": {
            "type": "integer"
          },
          "trending_score": {
            "type": "number"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "title": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "title_source": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "title_source": {
            "type": "string"
          }
        }
      }
    }
  ],
  "$defs": {
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
