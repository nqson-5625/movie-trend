{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "movie_batch_stats source document (Phase2-3.0, P2)",
  "description": "Một phim, toàn bộ lịch sử trước batch_cutoff_time. Field lấy nguyên từ movie_stats.tsv của Module 04; _id = serialize_key_v1((batch_run_id, movieId)).",
  "type": "object",
  "additionalProperties": false,
  "required": ["batch_run_id", "batch_cutoff_time", "generated_at", "movieId", "total_count", "rating_count", "rating_sum", "avg_rating"],
  "properties": {
    "batch_run_id": {"type": "string", "minLength": 1},
    "batch_cutoff_time": {"$ref": "#/$defs/utcTimestamp"},
    "generated_at": {"$ref": "#/$defs/utcTimestamp"},
    "movieId": {"type": "integer", "minimum": 1},
    "title": {"type": ["string", "null"]},
    "total_count": {"type": "integer", "minimum": 1},
    "rating_count": {"type": "integer", "minimum": 1},
    "rating_sum": {"type": "number", "minimum": 0.5},
    "avg_rating": {"type": "number", "minimum": 0.5, "maximum": 5.0}
  },
  "$defs": {
    "utcTimestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
