{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "analytics_genre_trends document (Phase2-3.0, P3; dùng cho D3)",
  "description": "Grain (batch_run_id, period_type, period_start, genre). Lưu đủ mọi thể loại trong kỳ; rank_in_period = row_number theo interaction_count giảm dần, hòa thì genre tăng dần.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analytics_run_id",
    "published_at",
    "batch_run_id",
    "batch_cutoff_time",
    "ref_version",
    "manifest_hash",
    "period_type",
    "period_start",
    "genre",
    "interaction_count",
    "rating_count",
    "rating_sum",
    "avg_rating",
    "rank_in_period"
  ],
  "properties": {
    "schema_version": { "const": "phase2-3.0" },
    "analytics_run_id": { "type": "string", "minLength": 1 },
    "published_at": { "$ref": "#/$defs/utcTimestamp" },
    "batch_run_id": { "type": "string", "minLength": 1 },
    "batch_cutoff_time": { "$ref": "#/$defs/utcTimestamp" },
    "ref_version": { "type": "string", "minLength": 1 },
    "manifest_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "period_type": { "enum": ["day", "month", "year"] },
    "period_start": { "$ref": "#/$defs/utcDate" },
    "genre": { "type": "string", "minLength": 1 },
    "interaction_count": { "type": "integer", "minimum": 1 },
    "rating_count": { "type": "integer", "minimum": 1 },
    "rating_sum": { "type": "number", "minimum": 0.5 },
    "avg_rating": { "type": "number", "minimum": 0.5, "maximum": 5.0 },
    "rank_in_period": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "utcDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
