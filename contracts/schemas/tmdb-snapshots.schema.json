{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TMDB movie snapshot v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "source", "tmdbId", "title", "popularity", "vote_count", "vote_average", "event_time", "ingest_time"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {"const": "tmdb"},
    "tmdbId": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "popularity": {"type": "number", "minimum": 0},
    "vote_count": {"type": "integer", "minimum": 0},
    "vote_average": {"type": "number", "minimum": 0, "maximum": 10},
    "event_time": {"$ref": "#/$defs/utcTimestamp"},
    "ingest_time": {"$ref": "#/$defs/utcTimestamp"}
  },
  "$defs": {
    "utcTimestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
