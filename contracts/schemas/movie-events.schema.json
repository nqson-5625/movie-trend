{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MovieLens movie event v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "source", "userId", "movieId", "rating", "event_time", "ingest_time"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {"const": "movielens"},
    "userId": {"type": "integer", "minimum": 1},
    "movieId": {"type": "integer", "minimum": 1},
    "rating": {"type": "number", "minimum": 0.5, "maximum": 5.0},
    "event_time": {"$ref": "#/$defs/utcTimestamp"},
    "ingest_time": {"$ref": "#/$defs/utcTimestamp"}
  },
  "$defs": {
    "utcTimestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
